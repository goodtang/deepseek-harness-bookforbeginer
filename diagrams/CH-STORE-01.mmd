flowchart TD
  subgraph First["第一个进程：本次查询"]
    A["工具结果提交到 Session"] --> B["持久化插件按序写入\n结束前等待 flush"]
  end
  B --> C["磁盘中的会话文件\nheader + 连续编号的事件"]
  B --> X["进程退出\n原内存对象结束"]
  subgraph Second["第二个进程：沿用同一会话 ID"]
    D["检查工作目录和会话归属"] --> E["取得写入权并读回事件\n重建 Session 与派生状态"]
    E --> F["提交新的用户输入\n组装含旧结果的新请求"]
  end
  C --> D
  F --> G["沿原事件序号追加\n本次新回合的结果"]
  G --> C
